# Production image for Cloudflare Containers. Built by deployments/cloudflare/deploy.sh.
# Requires linux/amd64.

FROM node:22-alpine AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit
COPY . .
RUN npm run build

FROM composer:2 AS vendor
WORKDIR /build
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY . .
RUN composer dump-autoload --optimize --no-dev

FROM php:8.4-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libicu-dev \
        libonig-dev \
        libpq-dev \
        libxml2-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        intl \
        mbstring \
        pcntl \
        pdo_pgsql \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

COPY docker/apache-vhost.conf /etc/apache2/sites-available/000-default.conf
COPY deployments/cloudflare/entrypoint.sh /usr/local/bin/talent-entrypoint
RUN chmod +x /usr/local/bin/talent-entrypoint

WORKDIR /var/www/html
COPY --from=vendor /build /var/www/html
COPY --from=assets /build/public/build /var/www/html/public/build

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    TRUSTED_PROXIES=*

EXPOSE 80
ENTRYPOINT ["talent-entrypoint"]
CMD ["apache2-foreground"]
