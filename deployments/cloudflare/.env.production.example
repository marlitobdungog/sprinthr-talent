# Copy to .env.production (git-ignored) and fill in. deploy.sh pushes these to Cloudflare as secrets.
APP_NAME="SprintHR Talent"
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
APP_URL=https://talent.example.com
APP_TIMEZONE=Asia/Manila

# Database. Use an external Neon connection here, or a Postgres you host elsewhere.
DB_CONNECTION=pgsql
DB_HOST=ep-xxxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=sprinthr_talent
DB_USERNAME=talent_app
DB_PASSWORD=REPLACE_ME
DB_SSLMODE=require

TALENT_API_KEY=REPLACE_WITH_LONG_RANDOM_KEY
TALENT_LOCAL_AUTH_ENABLED=true
TALENT_PRIVACY_POLICY_URL=https://sprinthr.com/legal/privacy-policy
TALENT_PRIVACY_POLICY_VERSION=sprinthr-2026-10-01
TALENT_RESUME_DISK=bucket-api-r2
BUCKET_API_URL=https://bucket.sprinthrapis.com
BUCKET_API_KEY=REPLACE_ME
BUCKET_NAME=sprinthr-talent

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://talent.example.com/auth/google/callback

MAIL_MAILER=log
LOG_LEVEL=info
