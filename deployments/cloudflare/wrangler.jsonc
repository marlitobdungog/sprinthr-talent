{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sprinthr-talent",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"workers_dev": true,
	"preview_urls": false,
	"containers": [
		{
			"class_name": "TalentApp",
			"scheduling_policy": "durable_object",
			"observability": {
				"logs": {
					"enabled": true
				}
			},
			"images": {
				"base": {
					"dockerfile": "../../Dockerfile.cloudflare",
					"build_context": "../.."
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TALENT_APP",
				"class_name": "TalentApp"
			}
		]
	},
	"exports": {
		"TalentApp": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		"CONTAINER_INSTANCE": "standard-1"
	}
}
